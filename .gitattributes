# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicitly handle binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.mp3 binary
*.wav binary
*.mp4 binary
*.webm binary
*.webp binary
*.safetensors binary
*.bin binary
*.exe binary
*.dll binary